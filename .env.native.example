# Native live-runtime overrides loaded after .env by scripts/native-runtime.sh.
# Copy to .env.native (gitignored). Keep secrets in .env; this file exists to
# neutralize bootstrap settings and translate container networking.
NATIVE_DATABASE_HOST=127.0.0.1
APP_ENV=live
APP_HOST=127.0.0.1
APP_PORT=8000
ALLOW_INSECURE_LOCAL_TLS=true
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8765
MCP_HTTP_ALLOWED_HOSTS=127.0.0.1:8765,localhost:8765,mcp.example.com,mcp.example.com:443
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
HOMELAB_CONFIG_PATH=/opt/homelab-console/config/homelab.local.yml
SECRETS_PATH=/opt/homelab-console/config/secrets.local.yml
