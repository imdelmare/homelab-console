{
  "loop_interval_seconds": 30,
  "recovery_confirmations": 2,
  "aggregation_window_seconds": 120,
  "notification_cooldown_seconds": 1800,
  "state_path": "data/sentinel.sqlite3",
  "listen_host": "127.0.0.1",
  "listen_port": 8766,
  "heartbeat_token": "change-me-in-env-or-local-config",
  "telegram": {
    "bot_token": "",
    "chat_id": "",
    "timeout_seconds": 8
  },
  "targets": [
    {
      "id": "api-public-health",
      "name": "Homelab Console API public readiness",
      "url": "https://console.example.com/health",
      "timeout_seconds": 5,
      "expected_status_min": 200,
      "expected_status_max": 399,
      "failure_confirmations": 3,
      "notification_group": "homelab-console-availability"
    }
  ],
  "heartbeats": [
    {
      "id": "home",
      "name": "Home network heartbeat",
      "timeout_seconds": 180,
      "failure_confirmations": 1,
      "notification_group": "homelab-console-availability"
    }
  ]
}
