# Homelab Console — environment template
#
# Copy to .env and fill in real values locally. Never commit a filled-in .env.
# Values below are safe placeholders — no real hosts, tokens, or credentials.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME=Homelab Console
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Optional process bind overrides used by the native units and Vite proxy.
# Leave unset to reuse APP_HOST/APP_PORT.
API_HOST=
API_PORT=
WEB_HOST=127.0.0.1
WEB_PORT=5173
# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# API tests and live operation use PostgreSQL via psycopg. Tests clone randomly
# named disposable databases and never modify POSTGRES_DB.
# Keep POSTGRES_PASSWORD and the password embedded in DATABASE_URL identical.
POSTGRES_USER=example
POSTGRES_PASSWORD=example
POSTGRES_DB=console
# Plain postgresql:// URLs are upgraded to the psycopg driver automatically.
DATABASE_URL=postgresql+psycopg://example:example@db:5432/console
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# ---------------------------------------------------------------------------
# Sessions & cookies
# ---------------------------------------------------------------------------
# Long random value used to sign session data. Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=change-me-with-a-long-random-value
SESSION_TTL_MINUTES=720
# `auto` enables Secure cookies in live mode. Use false only while the live
# console is intentionally served over trusted-LAN HTTP; prefer HTTPS + auto.
COOKIE_SECURE=auto
# Comma-separated list of allowed browser origins for the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Trust X-Forwarded-* headers only behind a controlled reverse proxy.
# Must stay false unless the app sits behind a proxy that sets these headers
# itself (see docs/DEPLOYMENT.md for the live reverse-proxy setup).
TRUSTED_PROXY_ENABLED=false
# Explicit exception for self-signed provider certificates on private IPs.
# Public endpoints remain blocked when verification is disabled.
ALLOW_INSECURE_LOCAL_TLS=false

# ---------------------------------------------------------------------------
# Authentication (two-factor: password + Telegram approval/OTP)
# ---------------------------------------------------------------------------
# test: logs the second-factor notification instead of sending it.
# telegram: sends approval buttons / OTP via the Telegram bot.
AUTH_NOTIFICATION_ADAPTER=test
# password: username + password, then Telegram approval/OTP (default).
# telegram_only: username identification, then Telegram approval/OTP as the
# sole authentication factor. Recovery codes are disabled in this mode.
AUTH_LOGIN_MODE=password
AUTH_RECOVERY_ENABLED=true

# Write-tool approval requests expire after this many seconds (ADR 0004).
APPROVAL_TTL_SECONDS=600

# Test-only bootstrap; live mode requires both values to remain empty.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Telegram bot (approvals, OTP delivery, /status /tasks /provider /approve /deny)
# ---------------------------------------------------------------------------
# Placeholder token shape — replace with a real bot token from @BotFather.
TELEGRAM_BOT_TOKEN=EXAMPLE:0000000000-bot-token
# Numeric Telegram user ID and chat ID allowed to operate the bot.
# The bot validates by ID, never by username.
TELEGRAM_ALLOWED_USER_ID=000000000
TELEGRAM_ALLOWED_CHAT_ID=000000000
# Shared secret required on the /api/telegram/webhook endpoint.
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook-secret
# Off by default so tests/CI never send real messages just because a token
# happens to be set. Turn on to get task.created/reopened/waiting_operator/
# blocked/completed + critical-finding pings on the same bot.
TELEGRAM_NOTIFICATIONS_ENABLED=false
NOTIFICATION_OUTBOX_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_SECONDS=2
# Keep this longer than one watcher interval so one noisy sample can clear
# before delivery (default watchers run every 600 seconds).
NOTIFICATION_WARNING_DEBOUNCE_SECONDS=900
NOTIFICATION_COOLDOWN_SECONDS=7200
NOTIFICATION_CRITICAL_DEBOUNCE_SECONDS=120
NOTIFICATION_CRITICAL_COOLDOWN_SECONDS=1800
NOTIFICATION_AGGREGATION_WINDOW_SECONDS=120
NOTIFICATION_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Operational retention
# ---------------------------------------------------------------------------
OPERATIONAL_RETENTION_ENABLED=true
RETENTION_INTERVAL_SECONDS=3600
AUDIT_RETENTION_DAYS=180
TOOL_INVOCATION_RETENTION_DAYS=90
WATCHER_RUN_RETENTION_DAYS=90
NOTIFICATION_OUTBOX_RETENTION_DAYS=90
RETENTION_BATCH_SIZE=1000

# ---------------------------------------------------------------------------
# Homelab inventory & provider secrets
# ---------------------------------------------------------------------------
# Inventory, host addresses and provider endpoints. For real local values,
# copy config/homelab.example.yml to config/homelab.local.yml and point this
# variable there. The local file is gitignored.
HOMELAB_CONFIG_PATH=config/homelab.example.yml
# Provider credentials only. Endpoint/base_url/host/port/verify_tls live in
# HOMELAB_CONFIG_PATH, not in this secrets file.
SECRETS_PATH=config/secrets.local.yml

# ---------------------------------------------------------------------------
# Audit
# ---------------------------------------------------------------------------
# Optional dev sink: also write audit events as JSONL (in addition to the DB).
AUDIT_JSONL_ENABLED=false

# ---------------------------------------------------------------------------
# MCP adapter
# ---------------------------------------------------------------------------
# MCP clients authenticate with per-client tokens issued or approved through
# Telegram. There is no shared static MCP login token.
MCP_AGENT_ID=codex
MCP_CLIENT_TOKEN_PATH=
MCP_CLIENT_LABEL=
MCP_PAIRING_TIMEOUT_SECONDS=300
# Optional network MCP transport. Keep unset unless you explicitly expose MCP
# on a trusted network. Remote clients must use a per-client token obtained via
# /api/mcp/pairing/start -> Telegram approval -> /api/mcp/pairing/consume.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
MCP_HTTP_PATH=/mcp/
MCP_HTTP_ALLOWED_HOSTS=127.0.0.1:8765,localhost:8765,mcp.example.com,mcp.example.com:443
MCP_HTTP_ALLOWED_ORIGINS=
# Public endpoint displayed in MCP client onboarding. Set only in trusted build environments.
VITE_MCP_ENDPOINT=https://mcp.example.com/mcp/

# Dedicated OpenCode-powered Fixer supervisor. The API sends only {"task_id": "..."}
# to this fixed endpoint after an explicit operator assignment.
FIXER_DISPATCH_ENABLED=false
FIXER_DISPATCH_URL=http://127.0.0.1:8767/fixer
FIXER_DISPATCH_SECRET=
FIXER_DISPATCH_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Conversation Service (Telegram free text + authenticated REST endpoints)
# ---------------------------------------------------------------------------
# Dedicated OpenAI API key for the lightweight conversation router.
OPENAI_API_KEY=
# Set ai_manager to prefer an inventory-declared LAN model with Luna fallback,
# or opencode_go to use the fixed direct OpenCode Go endpoint.
CONVERSATION_PROVIDER=ollama
CONVERSATION_MODEL=gpt-5.6-luna
# Direct OpenCode Go API. Keep the key only in the untracked runtime environment.
OPENCODE_GO_API_KEY=
OPENCODE_GO_CHAT_MODEL=deepseek-v4-flash
OPENCODE_GO_ROUTER_MODEL=deepseek-v4-pro
OPENCODE_GO_MAX_ATTEMPTS=3
CONVERSATION_REASONING_EFFORT=low
CONVERSATION_MAX_TURNS=4
CONVERSATION_MAX_TOOL_CALLS=3
CONVERSATION_MAX_OUTPUT_TOKENS=600
CONVERSATION_TIMEOUT_SECONDS=60
# Optional cost estimates, in currency units per 1M tokens. Leave 0 when unknown.
CONVERSATION_INPUT_COST_PER_MILLION=0
CONVERSATION_OUTPUT_COST_PER_MILLION=0
AI_MANAGER_HOST_ID=example-ai-host
AI_MANAGER_PORT=8080
AI_MANAGER_MODEL=Qwen3.5-4B-Q8_0
AI_MANAGER_CONNECT_TIMEOUT_SECONDS=2
AI_MANAGER_TIMEOUT_SECONDS=60
AI_MANAGER_FAILURE_COOLDOWN_SECONDS=90
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4-e4b-agentic:latest
OLLAMA_CONNECT_TIMEOUT_SECONDS=2
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_FAILURE_COOLDOWN_SECONDS=90
OLLAMA_KEEP_ALIVE=10m
TELEGRAM_MEDIA_ENABLED=true
TELEGRAM_MEDIA_MAX_IMAGE_BYTES=8000000
TELEGRAM_MEDIA_MAX_AUDIO_BYTES=10000000
TELEGRAM_MEDIA_MAX_AUDIO_SECONDS=120

# ---------------------------------------------------------------------------
# Task Router
# ---------------------------------------------------------------------------
# Optional asynchronous model pass that classifies newly created tasks and
# stores a task.router_decision event. It never claims tasks or executes tools.
TASK_ROUTER_ENABLED=false
# Empty inherits CONVERSATION_PROVIDER. Use opencode_go for the fixed direct API.
TASK_ROUTER_PROVIDER=
# Empty means reuse CONVERSATION_MODEL; set to a cheaper/lighter model if desired.
TASK_ROUTER_MODEL=
TASK_ROUTER_REASONING_EFFORT=low
TASK_ROUTER_MAX_OUTPUT_TOKENS=1000
TASK_ROUTER_TIMEOUT_SECONDS=30
TASK_ROUTER_WORKER_INTERVAL_SECONDS=1
TASK_ROUTER_JOB_LEASE_SECONDS=300
TASK_ROUTER_MAX_ATTEMPTS=3
INCIDENT_MATCHER_ENABLED=true
INCIDENT_MATCHER_MAX_CANDIDATES=5
INCIDENT_MATCHER_MAX_CALLS_PER_HOUR=10
INCIDENT_MATCHER_AUTO_HANDLE_CONFIDENCE=0.9

# ---------------------------------------------------------------------------
# Watchers
# ---------------------------------------------------------------------------
# Bootstrap default before the first persisted /api/watchers/automation toggle.
# Manual runs are always available at POST /api/watchers/run. When enabled, the
# API process schedules read-only watcher checks and can create deduplicated
# incident tasks.
WATCHERS_ENABLED=true
WATCHERS_INTERVAL_SECONDS=300
# warning creates tasks for warning+critical; critical only for critical alerts.
WATCHERS_MIN_SEVERITY=warning
# Comma-separated case-insensitive substrings matched against provider/message.
WATCHERS_IGNORE_PATTERNS=
# Resolve an open incident only after this many successful watcher runs miss it.
WATCHERS_RESOLVE_AFTER_MISSING_RUNS=3

# ---------------------------------------------------------------------------
# Frontend (apps/web)
# ---------------------------------------------------------------------------
# Empty means "same origin, relative /api/... paths" — the frontend already
# prefixes every call with /api. In dev, Vite's own proxy (vite.config.ts)
# forwards /api and /health to API_HOST:API_PORT when set, otherwise
# APP_HOST:APP_PORT above. Only set this to an absolute URL if the API is served
# from a different origin than the web app.
VITE_API_BASE_URL=
