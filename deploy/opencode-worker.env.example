FIXER_DISPATCH_SECRET=
OPENCODE_CONFIG=/var/lib/homelab-opencode/opencode.json
OPENCODE_WORKER_HOST=127.0.0.1
OPENCODE_WORKER_PORT=8767
OPENCODE_WORKER_PROJECT_DIR=/opt/homelab-console
OPENCODE_WORKER_BIN=/usr/local/bin/opencode
OPENCODE_WORKER_AGENT=homelab-fixer
OPENCODE_WORKER_TIMEOUT_SECONDS=1800
OPENCODE_PURE=1
OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1
OPENCODE_DISABLE_EXTERNAL_SKILLS=1
HOME=/var/lib/homelab-opencode
XDG_CONFIG_HOME=/var/lib/homelab-opencode/config
XDG_DATA_HOME=/var/lib/homelab-opencode/data
XDG_STATE_HOME=/var/lib/homelab-opencode/state
XDG_CACHE_HOME=/var/lib/homelab-opencode/cache
