FROM python:3.12-slim-bookworm

# The public repository does not download or redistribute Ookla Speedtest CLI.
# An operator who is permitted by the vendor's terms must provide the binary
# locally at local-assets/speedtest before building this private-use image.
COPY --chmod=0555 local-assets/speedtest /opt/speedtest-cli/speedtest

WORKDIR /app
COPY apps/speedtest_probe/server.py ./server.py

RUN useradd --create-home --uid 10003 --shell /usr/sbin/nologin probe \
    && mkdir -p /data \
    && chown probe:probe /data
USER probe

EXPOSE 8780

CMD ["python", "/app/server.py"]
