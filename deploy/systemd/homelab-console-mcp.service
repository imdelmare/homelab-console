[Unit]
Description=Homelab Console native MCP HTTP adapter
After=network-online.target
Wants=network-online.target homelab-console-api.service

[Service]
Type=simple
User=homelab-console
Group=homelab-console
WorkingDirectory=/opt/homelab-console
ExecStartPre=/opt/homelab-console/scripts/native-runtime.sh wait-db
ExecStart=/opt/homelab-console/scripts/native-runtime.sh mcp
Restart=on-failure
RestartSec=3
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
