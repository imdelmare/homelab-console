# Copy this file to the repository root as .env.compose. Never commit it.
COMPOSE_PROJECT_NAME=homelab-console

# Public GHCR Compose defaults. Replace tags with immutable sha256 digests for
# production after verifying the corresponding public release.
HOMELAB_MCP_API_IMAGE=ghcr.io/imdelmare/homelab-mcp-api:main
HOMELAB_MCP_MCP_IMAGE=ghcr.io/imdelmare/homelab-mcp-mcp:main
HOMELAB_MCP_WEB_IMAGE=ghcr.io/imdelmare/homelab-mcp-web:main

# Database and sessions. Generate independent long random values. Keep the
# database password URL-safe unless DATABASE_URL is supplied explicitly.
POSTGRES_USER=console
POSTGRES_PASSWORD=change-me-database-password
POSTGRES_DB=console
SESSION_SECRET=change-me-with-a-long-random-value
SESSION_TTL_MINUTES=720

# Secure cookies require HTTPS. Set false only for a temporary loopback/LAN HTTP
# evaluation, never for an Internet-facing deployment.
COOKIE_SECURE=true
CORS_ORIGINS=
ALLOW_INSECURE_LOCAL_TLS=false

# Telegram is the operator approval and second-factor channel.
AUTH_LOGIN_MODE=password
AUTH_RECOVERY_ENABLED=true
APPROVAL_TTL_SECONDS=600
TELEGRAM_BOT_TOKEN=EXAMPLE:0000000000-bot-token
TELEGRAM_ALLOWED_USER_ID=000000000
TELEGRAM_ALLOWED_CHAT_ID=000000000
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook-secret
TELEGRAM_NOTIFICATIONS_ENABLED=false

# Operator-owned files mounted individually and read-only. Relative paths are
# resolved from deploy/compose/ by Docker Compose.
HOMELAB_CONFIG_FILE=../../config/homelab.local.yml
SECRETS_FILE=../../config/secrets.local.yml
RUNBOOKS_CONFIG_FILE=../../config/runbooks.example.yml

# Core automation is read-only unless an exact write tool is governance-approved
# and a single-use operator approval is consumed.
WATCHERS_ENABLED=true
WATCHERS_INTERVAL_SECONDS=600
WATCHERS_MIN_SEVERITY=warning
WATCHERS_IGNORE_PATTERNS=
WATCHERS_RESOLVE_AFTER_MISSING_RUNS=3

# Loopback-only host bindings. Put a controlled TLS proxy/tunnel in front.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=8765
MCP_HTTP_PATH=/mcp/
MCP_HTTP_ALLOWED_HOSTS=127.0.0.1:8765,localhost:8765
MCP_HTTP_ALLOWED_ORIGINS=
# Source-build Compose only. Published GHCR web images are immutable and use
# same-origin /api paths; these values cannot reconfigure a prebuilt image.
VITE_API_BASE_URL=
VITE_MCP_ENDPOINT=
