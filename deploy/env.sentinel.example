# VPS-only External Sentinel environment.
# Copy to .env.sentinel on the VPS and fill real values there. Do not commit it.

SENTINEL_CONFIG_PATH=/app/config/sentinel.local.json
SENTINEL_STATE_PATH=/app/data/sentinel.sqlite3
SENTINEL_HEARTBEAT_TOKEN=change-me-long-random-token
SENTINEL_LISTEN_HOST=0.0.0.0
SENTINEL_LISTEN_PORT=8766
# Keep loopback when Caddy/Nginx terminates TLS locally; use 0.0.0.0:8766 only
# for a deliberate direct exposure.
SENTINEL_BIND=127.0.0.1:8766

TELEGRAM_BOT_TOKEN=EXAMPLE:0000000000-bot-token
TELEGRAM_ALLOWED_CHAT_ID=000000000
