# Homelab Console web frontend — static build served by Nginx
#
# Build context must be the repository root, e.g.:
#   docker build -f deploy/Dockerfile.web -t homelab-console-web .

# --- build stage ------------------------------------------------------------
FROM node:22-slim AS build

WORKDIR /app

COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

COPY apps/web/ ./

# Build-time API base URL baked into the static bundle. Empty means "same
# origin" — the frontend already prefixes every call with /api, and Nginx
# proxies /api/* to the api service (see deploy/nginx.conf). Override with
# --build-arg VITE_API_BASE_URL=https://your-domain.example only if the API
# is served from a different origin than the web app.
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

# --- serve stage -------------------------------------------------------------
FROM nginx:1.27-alpine AS serve

COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
